/***************************
    Combat Tracker
***************************/

.sheet-actions-taken {
    margin-top: 12px;
    padding: 10px;
    background-color: var(--border);
    border-radius: 10px;
}

/* Header styling – matches inventory headers */
.sheet-actions-taken label.header {
    display: block;
    text-align: center;
    border-width: 0 0 3px;
    border-style: solid;
    border-color: var(--background);
    border-radius: 10px;
    margin-bottom: 5px;
    padding: 0;
    color: var(--background);
    font-weight: bold;
    font-size: 13pt;
}

.sheet-actions-taken label {
    color: var(--background);
}

/* All action rows */
.sheet-actions-taken .sheet-action-row {
    background-color: var(--background);
    padding: 5px 120px 5px 10px;     /* extra right padding to prevent text overlap with checkboxes */
    margin-bottom: 2px;
    border-radius: 10px;
    line-height: 1.4;
    min-height: 28px;                /* ensures row has visible height even with absolute children */
    position: relative;              /* needed for absolute positioning of checkboxes */
    box-sizing: border-box;
}

.sheet-actions-taken strong {
    display: inline-block;
    width: 140px;               /* ← change from 120px to 140px – gives ~20px breathing room */
    text-align: left;
    color: black;
    font-weight: bold;
    vertical-align: middle;
    margin-right: 10px;
}

/* Checkboxes positioned on the right side */
.sheet-actions-taken .sheet-action-row input[type="checkbox"] {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    margin: 0;
}

/* Position each checkbox from the right edge */
.sheet-actions-taken .sheet-action-row input[type="checkbox"]:nth-of-type(1) { right: 10px; }
.sheet-actions-taken .sheet-action-row input[type="checkbox"]:nth-of-type(2) { right: 34px; }
.sheet-actions-taken .sheet-action-row input[type="checkbox"]:nth-of-type(3) { right: 58px; }
.sheet-actions-taken .sheet-action-row input[type="checkbox"]:nth-of-type(4) { right: 82px; }
.sheet-actions-taken .sheet-action-row input[type="checkbox"]:nth-of-type(5) { right: 106px; }

/* Optional: remove trailing margin on the last checkbox if needed */
.sheet-actions-taken .sheet-action-row input[type="checkbox"]:last-of-type {
    margin-right: 0;
}

