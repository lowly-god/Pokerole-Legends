.sheet-toggle {
    display: inline-block;
    position: relative;
}

.sheet-toggle input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 1;
}

.sheet-toggle span {
    display: block;
    padding: 2px 15px;
    border: 1px solid black;
    border-radius: 10px;
    background: var(--foreground);      /* unselected */
    color: whitesmoke;                             /* light text on dark bg */
    font-weight: bold;
    transition: background-color 0.2s ease, color 0.2s ease;
    user-select: none;
}

.sheet-toggle {
    display: inline-block;
    position: relative;
}

.sheet-toggle input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 1;
}

.sheet-toggle span {
    display: block;
    padding: 2px 15px;
    border: 1px solid black;
    border-radius: 10px;
    background: var(--background);      /* unselected = light #cccccc */
    color: black;
    font-weight: bold;
    transition: background-color 0.2s ease, color 0.2s ease;
    user-select: none;
    cursor: pointer;
}

/* Selected = dark background + light text */
.sheet-toggle input:checked ~ span {
    background: var(--foreground) !important;   /* dark */
    color: whitesmoke !important;
}

/* Hover: subtle darken on unselected only */
.sheet-toggle input:not(:checked) ~ span:hover {
    background: color-mix(in srgb, var(--background) 70%, black 30%);
}

/* Reinforce pointer */
.sheet-toggle:hover {
    cursor: pointer;
}

